# Agentic Security Auditor
# Copy this file to .env for local development.
# Never commit the .env file.

# AI Provider
ANTHROPIC_API_KEY=

# Application
APP_ENV=development
LOG_LEVEL=INFO

# API
API_HOST=127.0.0.1
API_PORT=8000

# Scanner
SEMGREP_TIMEOUT_SECONDS=60
BANDIT_TIMEOUT_SECONDS=60

# Future database
# DATABASE_URL=

# Future GitHub integration
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_TOKEN=
